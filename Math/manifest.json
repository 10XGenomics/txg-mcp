{
  "dxt_version": "0.1",
  "name": "math-hello-world",
  "display_name": "Math Hello World",
  "version": "1.0.0",
  "description": "A simple MCP server that adds two numbers",
  "author": {
    "name": "Math Extension Developer"
  },
  "server": {
    "type": "python",
    "entry_point": "server/main.py",
    "mcp_config": {
      "command": "python",
      "args": [
        "${__dirname}/server/main.py"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1",
        "DEBUG": "${user_config.debug_mode}",
        "PYTHONPATH": "${__dirname}/server/lib"
      }
    }
  },
  "tools": [
    {
      "name": "add",
      "description": "Add two numbers together"
    }
  ],
  "user_config": {
    "debug_mode": {
      "type": "boolean",
      "title": "Debug Mode",
      "description": "Enable debug logging",
      "default": false,
      "required": false
    }
  },
  "keywords": ["math", "calculator", "addition", "arithmetic"],
  "license": "MIT",
  "compatibility": {
    "claude_desktop": ">=0.10.0",
    "platforms": ["darwin", "win32", "linux"],
    "runtimes": {
      "python": ">=3.8.0 <4"
    }
  }
}