{
  "name": "10x-genomics-mcp",
  "version": "1.0.0",
  "description": "10x Genomics Cloud Analysis MCP Server",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "build": "tsc",
    "build:prod": "tsc -p tsconfig.prod.json",
    "start": "./tasks.sh run-server",
    "clean": "rm -rf build/server",
    "pack": "./tasks.sh pack",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "generate-capabilities": "./tasks.sh generate-capabilities",
    "download-bin": "./tasks.sh download-bin",
    "release": "npm run clean && npm run build:prod && npm run test && npm run generate-capabilities && npm run pack"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.15.1",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.17",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.4",
    "tsx": "^4.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
